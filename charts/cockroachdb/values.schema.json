{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "resources": {
        "category": "compute",
        "type": "object",
        "properties": {
          "requests": {
            "type": "object",
            "properties": {
              "memory": {
                "type": "string",
                "default": "512Mi", "mutable": true
              },
              "cpu": {
                "type": "string",
                "default": "100m", "mutable": true
              }
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "memory": {
                "type": "string",
                "default": "512Mi", "mutable": true
              },
              "cpu": {
                "type": "string",
                "default": "100m", "mutable": true
              }
            }
          }
        }
      },
      "diskSize": {
        "category": "compute",
        "type": "string",
        "default": "10Gi", "mutable": true,
        "editDisabled": true
      },
      "version": {
        "category": "runtime",
      "default": "v25.1.2",
      "mutable": true
    },
      "services": {
        "category": "runtime",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "database": {
              "type": "string"
            }
          },
          "required": ["name", "database"]
        }
      },

      "nodeSelector": {
        "category": "advanced",
        "type": "object",
        "description": "Node labels the pod must match, for pinning the workload to a node pool",
        "default": {},
        "mutable": true
      },

      "tolerations": {
        "category": "advanced",
        "type": "array",
        "description": "Taints the pod tolerates, so it can schedule onto a tainted node pool",
        "default": [],
        "mutable": true
      },

      "affinity": {
        "category": "advanced",
        "type": "object",
        "description": "Pod affinity / anti-affinity rules, applied verbatim to the pod spec. Setting this replaces the chart's default pod-anti-affinity",
        "default": {},
        "mutable": true
      }
    }
}