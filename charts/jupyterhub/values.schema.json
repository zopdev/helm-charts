{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "hub": {
      "category": "advanced",
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "JupyterHub": {
              "type": "object",
              "properties": {
                "admin_access": {
                  "type": "boolean",
                  "mutable": true
                },
                "authenticator_class": {
                  "type": "string",
                  "mutable": true
                }
              }
            }
          }
        },
        "baseUrl": {
          "type": "string",
          "mutable": true
        }
      }
    },
    "proxy": {
      "category": "advanced",
      "type": "object",
      "properties": {
        "https": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "mutable": true
            },
            "type": {
              "type": "string"
            },
            "letsencrypt": {
              "type": "object",
              "properties": {
                "acmeServer": {
                  "type": "string"
                }
              }
            },
            "secret": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "crt": {
                  "type": "string"
                }
              }
            },
            "hosts": {
              "type": "array",
              "mutable": true
            }
          }
        }
      }
    },
    "singleuser": {
      "category": "runtime",
      "type": "object",
      "properties": {
        "networkTools": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                }
              }
            }
          }
        },
        "cloudMetadata": {
          "type": "object",
          "properties": {
            "blockWithIptables": {
              "type": "boolean"
            },
            "ip": {
              "type": "string"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "egressAllowRules": {
              "type": "object",
              "properties": {
                "cloudMetadataServer": {
                  "type": "boolean"
                },
                "dnsPortsCloudMetadataServer": {
                  "type": "boolean"
                },
                "dnsPortsKubeSystemNamespace": {
                  "type": "boolean"
                },
                "dnsPortsPrivateIPs": {
                  "type": "boolean"
                },
                "nonPrivateIPs": {
                  "type": "boolean"
                },
                "privateIPs": {
                  "type": "boolean"
                }
              }
            },
            "interNamespaceAccessLabels": {
              "type": "string"
            }
          }
        },
        "events": {
          "type": "boolean"
        },
        "extraLabels": {
          "type": "object",
          "properties": {
            "hub.jupyter.org/network-access-hub": {
              "type": "string"
            }
          }
        },
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "uid": {
          "type": "integer"
        },
        "fsGid": {
          "type": "integer"
        },
        "storage": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "mutable": true
            },
            "static": {
              "type": "object",
              "properties": {
                "subPath": {
                  "type": "string"
                }
              }
            },
            "capacity": {
              "type": "string",
              "mutable": true
            },
            "homeMountPath": {
              "type": "string"
            },
            "dynamic": {
              "type": "object",
              "properties": {
                "volumeNameTemplate": {
                  "type": "string"
                },
                "storageAccessModes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "mutable": true
            },
            "tag": {
              "type": "string",
              "mutable": true
            }
          }
        },
        "cmd": {
          "type": "string"
        }
      }
    },
    "scheduling": {
      "category": "compute",
      "type": "object",
      "properties": {
        "userScheduler": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "mutable": true
            },
            "replicas": {
              "type": "integer",
              "mutable": true
            },
            "logLevel": {
              "type": "integer"
            }
          }
        }
      }
    },
    "prePuller": {
      "category": "advanced",
      "type": "object",
      "properties": {
        "hook": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pullOnlyOnChanges": {
              "type": "boolean"
            }
          }
        },
        "continuous": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "cull": {
      "category": "advanced",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "mutable": true
        },
        "users": {
          "type": "boolean"
        },
        "adminUsers": {
          "type": "boolean"
        },
        "removeNamedServers": {
          "type": "boolean"
        },
        "timeout": {
          "type": "integer",
          "mutable": true
        },
        "every": {
          "type": "integer",
          "mutable": true
        },
        "concurrency": {
          "type": "integer"
        },
        "maxAge": {
          "type": "integer"
        }
      }
    }
  }
}
