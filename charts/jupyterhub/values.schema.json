{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "singleuser": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "default": "quay.io/jupyterhub/k8s-singleuser-sample",
              "mutable": true,
              "description": "Notebook image users get, e.g. quay.io/jupyterhub/k8s-singleuser-sample or a datascience image"
            },
            "tag": {
              "type": "string",
              "default": "4.1.1-0.dev.git.6957.h0e735928",
              "mutable": true,
              "description": "Tag of the notebook image"
            }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "capacity": {
              "type": "string",
              "default": "10Gi",
              "mutable": true,
              "description": "Persistent home directory size per user, e.g. 10Gi"
            }
          }
        }
      },
      "category": "runtime"
    },
    "hub": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "JupyterHub": {
              "type": "object",
              "properties": {
                "authenticator_class": {
                  "type": "string",
                  "default": "dummy",
                  "mutable": true,
                  "description": "How users log in. The default \"dummy\" accepts ANY username/password \u2014 change this before exposing JupyterHub"
                },
                "admin_access": {
                  "type": "boolean",
                  "default": true,
                  "mutable": true,
                  "description": "Allow admins to access other users' notebook servers"
                }
              }
            }
          }
        }
      },
      "category": "advanced"
    },
    "cull": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "mutable": true,
          "description": "Shut down idle notebook servers to free compute"
        },
        "timeout": {
          "type": "integer",
          "default": 3600,
          "mutable": true,
          "description": "Seconds a notebook may sit idle before it is culled"
        }
      },
      "category": "runtime"
    },
    "proxy": {
      "type": "object",
      "properties": {
        "https": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "mutable": true,
              "description": "Terminate HTTPS at the proxy"
            },
            "hosts": {
              "type": "array",
              "default": [],
              "mutable": true,
              "description": "Hostnames to serve HTTPS for, e.g. [\"jupyter.example.com\"]"
            }
          }
        }
      },
      "category": "advanced"
    }
  }
}
