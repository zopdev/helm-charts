{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "category": "runtime",
      "type": "string",
      "default": "7.8.0",
      "mutable": true
    },
    "zookeeper": {
      "category": "advanced",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "url": {
          "type": "string",
          "default": ""
        }
      }
    },
    "resources": {
      "category": "compute",
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m$",
              "default": "500m",
              "mutable": true
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+Mi$",
              "default": "500Mi",
              "mutable": true
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m$",
              "default": "1000m",
              "mutable": true
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+Mi$",
              "default": "1500Mi",
              "mutable": true
            }
          }
        }
      }
    },
    "diskSize": {
      "category": "compute",
      "type": "string",
      "pattern": "^[0-9]+Gi$",
      "default": "10Gi",
      "mutable": true,
      "editDisabled": true
    },
    "services": {
      "category": "runtime",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": ["name"]
        }
      },

    "nodeSelector": {
      "category": "advanced",
      "type": "object",
      "description": "Node labels the pod must match, for pinning the workload to a node pool",
      "default": {},
      "mutable": true
    },

    "tolerations": {
      "category": "advanced",
      "type": "array",
      "description": "Taints the pod tolerates, so it can schedule onto a tainted node pool",
      "default": [],
      "mutable": true
    },

    "affinity": {
      "category": "advanced",
      "type": "object",
      "description": "Pod affinity / anti-affinity rules, applied verbatim to the pod spec. Setting this replaces the chart's default pod-anti-affinity",
      "default": {},
      "mutable": true
    }
  }
} 