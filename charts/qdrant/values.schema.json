{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "category": "runtime",
      "type": "string",
      "default": "v1.19.0",
      "mutable": true
    },
    "diskSize": {
      "category": "compute",
      "type": "string",
      "pattern": "^[0-9]+Gi$",
      "default": "10Gi",
      "mutable": true,
      "editDisabled": true
    },
    "customConfig": {
      "category": "advanced",
      "type": "string",
      "default": "",
      "mutable": true
    },
    "resources": {
      "category": "compute",
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m$",
              "default": "250m",
              "mutable": true
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi)$",
              "default": "512Mi",
              "mutable": true
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m$",
              "default": "1000m",
              "mutable": true
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi)$",
              "default": "2Gi",
              "mutable": true
            }
          }
        }
      }
    }
  }
}
